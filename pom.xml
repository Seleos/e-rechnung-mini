<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>einvoice</groupId>
    <artifactId>einvoice-mini</artifactId>
    <version>0.10.1</version>
    <name>E-Rechnung Mini</name>
    <description>Small desktop app for creating ZUGFeRD e-invoices (EN 16931)</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>27.0.1</javafx.version>
        <mustang.version>2.26.0</mustang.version>
        <main.class>einvoice.Launcher</main.class>
        <coverage.minimum>0.80</coverage.minimum>
        <mutation.minimum>70</mutation.minimum>
        <dist.vendor>Seleos GmbH</dist.vendor>
        <dist.identifier>de.seleos.einvoice</dist.identifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>library</artifactId>
            <version>${mustang.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>validator</artifactId>
            <version>${mustang.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>fop</artifactId>
            <version>2.11</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.23.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.23.0</version>
        </dependency>
        <dependency>
            <!-- Official EN 16931 rule files, used by a test as a validator independent of Mustang -->
            <groupId>com.helger.phive.rules</groupId>
            <artifactId>phive-rules-en16931</artifactId>
            <version>4.7.0</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Only app.properties takes values from this POM; all other resources are copied unchanged -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>einvoice/app.properties</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>einvoice/app.properties</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.4.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>lint</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Test coverage: report in target/site/jacoco, minimum for everything except the user interface -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <id>coverage-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <excludes>
                                <exclude>einvoice/ui/**</exclude>
                                <exclude>einvoice/Launcher.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Static analysis for real bugs such as null access or ignored results -->
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.5.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>bug-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Formatting that can be fixed automatically: ./mvnw spotless:apply -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <java>
                        <importOrder>
                            <order>,javax|java,\#</order>
                        </importOrder>
                        <removeUnusedImports>
                            <engine>cleanthat-javaparser-unnecessaryimport</engine>
                        </removeUnusedImports>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>format-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- API documentation in target/reports/apidocs; broken Javadoc fails the build -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <show>package</show>
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>api-docs</id>
                        <phase>verify</phase>
                        <goals><goal>javadoc</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- List of all bundled libraries with their licences in target/generated-sources/license -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.9.0</version>
                <configuration>
                    <includedScopes>compile,runtime</includedScopes>
                    <failOnMissing>true</failOnMissing>
                </configuration>
                <executions>
                    <execution>
                        <id>third-party-licenses</id>
                        <phase>verify</phase>
                        <goals><goal>add-third-party</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Software bill of materials (CycloneDX) in target/bom.json and target/bom.xml -->
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <configuration>
                    <includeTestScope>false</includeTestScope>
                </configuration>
                <executions>
                    <execution>
                        <id>sbom</id>
                        <phase>package</phase>
                        <goals><goal>makeBom</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-libraries</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/app</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/app</outputDirectory>
                    <archive>
                        <manifest><mainClass>${main.class}</mainClass></manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Installer for the current operating system: ./mvnw -Pdist -DskipTests package
          macOS produces a .dmg, Windows an .msi, Linux a .deb, each with its own Java runtime, in target/dist.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.8.0</version>
                        <configuration>
                            <name>${project.name}</name>
                            <appVersion>${project.version}</appVersion>
                            <vendor>${dist.vendor}</vendor>
                            <description>${project.description}</description>
                            <type>${dist.type}</type>
                            <icon>${dist.icon}</icon>
                            <input>${project.build.directory}/app</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <mainClass>${main.class}</mainClass>
                            <destination>${project.build.directory}/dist</destination>
                            <javaOptions>
                                <option>--enable-native-access=ALL-UNNAMED</option>
                            </javaOptions>
                            <macPackageIdentifier>${dist.identifier}</macPackageIdentifier>
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winPerUserInstall>true</winPerUserInstall>
                            <!-- Must stay the same for all versions so that an update replaces the old one -->
                            <winUpgradeUuid>5d0c8f0e-6a0b-4d7e-9a53-2f6f3e1b7c41</winUpgradeUuid>
                        </configuration>
                        <executions>
                            <execution>
                                <id>installer</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          Mutation tests: ./mvnw -Pmutation test
          Changes the code in small ways and checks that a test notices. Slow, so not part of the normal build.
          Report in target/pit-reports/index.html.
        -->
        <profile>
            <id>mutation</id>
            <properties>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.2</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>einvoice.core.*</param>
                                <param>einvoice.i18n.*</param>
                                <param>einvoice.model.*</param>
                                <param>einvoice.service.*</param>
                                <param>einvoice.storage.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>einvoice.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>einvoice.ui.*</param>
                            </excludedTestClasses>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <mutationThreshold>${mutation.minimum}</mutationThreshold>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mutation-tests</id>
                                <phase>test</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dist-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <dist.type>DMG</dist.type>
                <dist.icon>src/main/packaging/icon.icns</dist.icon>
            </properties>
        </profile>
        <profile>
            <id>dist-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <dist.type>MSI</dist.type>
                <dist.icon>src/main/packaging/icon.ico</dist.icon>
            </properties>
        </profile>
        <profile>
            <id>dist-linux</id>
            <activation><os><name>Linux</name></os></activation>
            <properties>
                <dist.type>DEB</dist.type>
                <dist.icon>src/main/packaging/icon.png</dist.icon>
            </properties>
        </profile>
    </profiles>
</project>
